custom_nodes: []
tools: []
assistants:
- id: stage-1
  assistant_id: "{{ASSISTANT_ID_1}}"
- id: stage-2
  assistant_id: "{{ASSISTANT_ID_2}}"
- id: stage-3
  assistant_id: "{{ASSISTANT_ID_3}}"
- id: stage-4
  assistant_id: "{{ASSISTANT_ID_4}}"
- id: stage-5
  assistant_id: "{{ASSISTANT_ID_5}}"
- id: stage-6
  assistant_id: "{{ASSISTANT_ID_6}}"
- id: stage-7
  assistant_id: "{{ASSISTANT_ID_7}}"
- id: stage-8
  assistant_id: "{{ASSISTANT_ID_8}}"
states:
- id: stage-1
  assistant_id: stage-1
  task: |
    Execute SDLC Stage 1 (Requirements Analysis) for the Jira issue named in the user's input.
    Confirm the issue key and title with the Jira toolkit first, then run the PREFLIGHT and create the run branch (see the AUTOMATION rule) and record RUN_BRANCH.
    Produce requirements.md as chat output only (no file), present it with open questions and assumptions, and stop. Do not start any other stage.
  resolve_dynamic_values_in_prompt: true
  next:
    state_id: stage-2
- id: stage-2
  assistant_id: stage-2
  task: |
    Execute SDLC Stage 2 (Architecture Design) for the Jira issue named in the user's input.
    The human has approved Stage 1 (Requirements Analysis). Use requirements.md as presented earlier in the conversation context (chat history) as your input. Do not save it to a file.
    Produce architecture.md as chat output only (no file), present it with open questions and assumptions, and stop. Do not start any other stage.
  interrupt_before: true
  resolve_dynamic_values_in_prompt: true
  next:
    state_id: stage-3
- id: stage-3
  assistant_id: stage-3
  task: |
    Execute SDLC Stage 3 (Design Review) for the Jira issue named in the user's input.
    The human has approved Stage 2 (Architecture Design). Use architecture.md as presented earlier in the conversation context (chat history) as your input. Do not save it to a file.
    Produce design-review.md as chat output only (no file), present it with open questions and assumptions, and stop. Do not start any other stage.
  interrupt_before: true
  resolve_dynamic_values_in_prompt: true
  next:
    state_id: stage-4
- id: stage-4
  assistant_id: stage-4
  task: |
    Execute SDLC Stage 4 (Implementation Planning) for the Jira issue named in the user's input.
    The human has approved Stage 3 (Design Review). Use design-review.md as presented earlier in the conversation context (chat history) as your input. Do not save it to a file.
    Produce impl-plan.md as chat output only (no file), present it with open questions and assumptions, and stop. Do not start any other stage.
  interrupt_before: true
  resolve_dynamic_values_in_prompt: true
  next:
    state_id: stage-5
- id: stage-5
  assistant_id: stage-5
  task: |
    Execute SDLC Stage 5 (Implementation) for the Jira issue named in the user's input.
    The human has approved Stage 4 (Implementation Planning). Use impl-plan.md as presented earlier in the conversation context (chat history) as your input. Do not save it to a file.
    Implement the approved plan yourself and commit it to branch <RUN_BRANCH> with the GitHub API tool (see the AUTOMATION rule).
    Produce implementation-notes.md as chat output only (no file), present it with open questions and assumptions, and stop. Do not start any other stage.
  interrupt_before: true
  resolve_dynamic_values_in_prompt: true
  next:
    state_id: stage-6
- id: stage-6
  assistant_id: stage-6
  task: |
    Execute SDLC Stage 6 (Code Review) for the Jira issue named in the user's input.
    The human has approved Stage 5 (Implementation). Use implementation-notes.md as presented earlier in the conversation context (chat history) as your input. Do not save it to a file.
    Produce code-review.md as chat output only (no file), present it with open questions and assumptions, and stop. Do not start any other stage.
  interrupt_before: true
  resolve_dynamic_values_in_prompt: true
  next:
    state_id: stage-7
- id: stage-7
  assistant_id: stage-7
  task: |
    Execute SDLC Stage 7 (Verification) for the Jira issue named in the user's input.
    The human has approved Stage 6 (Code Review). Use code-review.md as presented earlier in the conversation context (chat history) as your input. Do not save it to a file.
    Verify branch <RUN_BRANCH> by evidence (see the AUTOMATION rule); the sandbox cannot run tests, so mark test execution NOT-RUN unless real CI or user output exists.
    Produce verification-report.md as chat output only (no file), present it with open questions and assumptions, and stop. Do not start any other stage.
  interrupt_before: true
  resolve_dynamic_values_in_prompt: true
  next:
    state_id: stage-8
- id: stage-8
  assistant_id: stage-8
  task: |
    Execute SDLC Stage 8 (Pull Request Preparation) for the Jira issue named in the user's input.
    The human has approved Stage 7 (Verification). Use verification-report.md as presented earlier in the conversation context (chat history) as your input. Do not save it to a file.
    Produce pr-summary.md as chat output only (no file), present it with open questions and assumptions, and stop. Do not start any other stage.
  interrupt_before: true
  resolve_dynamic_values_in_prompt: true
  next:
    state_id: stage-9-open-pr
- id: stage-9-open-pr
  assistant_id: stage-8
  task: |
    The human has approved the Stage 8 PR summary. Open the pull request now (PR creation step of the AUTOMATION rule): head <RUN_BRANCH>, base main, body = the approved PR summary from the conversation context.
    Never merge. Report the real PR URL or the exact tool error, then stop.
  interrupt_before: true
  resolve_dynamic_values_in_prompt: true
  next:
    state_id: end
