{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc-policy.cjs\"" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent|Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sdlc-policy.cjs\"" }]
      }
    ]
  }
}
